{
  "name": "TW/ds",
  "version": "0.2",
  "date": "2026-11-11",
  "repo": "https://github.com/tdwndr/site/tree/main/tools/ds",
  "color": {
    "light": {
      "paper": "#FAF8F3",
      "ink": "#2A211B",
      "accent": "#1A33F5",
      "on-accent": "#FFFFFF",
      "highlighter": "#FFD98A",
      "good": "#2F6B4F",
      "bad": "#A63D2F",
      "warn": "#8A5B00"
    },
    "dark": {
      "paper": "#171410",
      "ink": "#EDE8DE",
      "accent": "#8C9BFF",
      "on-accent": "#14161B",
      "highlighter": "#FFD98A",
      "good": "#7FC4A0",
      "bad": "#E58A7A",
      "warn": "#E0B25A"
    },
    "derived": {
      "muted": "ink 72% over paper",
      "rule": "ink 14% over paper",
      "rule-strong": "ink 38% over paper",
      "wash": "accent 9% over paper"
    }
  },
  "font": {
    "display": "Schibsted Grotesk",
    "body": "IBM Plex Sans",
    "mono": "Geist Mono",
    "serif": "Newsreader"
  },
  "type": {
    "ratio": 1.333,
    "base": "1rem",
    "label": "0.75rem",
    "leading": { "read": 1.8, "ui": 1.5, "tight": 1.05 },
    "measure": "70ch"
  },
  "space": [0.25, 0.5, 1, 1.5, 2, 3, 4, 6, 8],
  "radius": { "base": "0.5rem", "pill": "999px" },
  "line": "1px",
  "motion": {
    "micro": "0.25s",
    "set": "1.1s",
    "ease-ui": "cubic-bezier(.2,.7,.2,1)",
    "ease-out": "cubic-bezier(.16,1,.3,1)"
  }
}
